# Real values — never commit
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Local state, even though backend is GCS
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Terraform lock file — commit this one
# .terraform.lock.hcl is INTENTIONALLY tracked for reproducible provider versions.
.terraform/
.terraform.tfstate.lock.info

# Local env files — never commit
.env
.env.prod
.env.local

# Cloudflare Origin CA cert + key — never commit
origin-ca/
*.pem
*.key

# Generated Caddy config (#849) — Caddyfile.tpl is the single source of truth.
# deploy.sh renders ./Caddyfile from it on every deploy (and via
# `deploy.sh --generate-caddyfile` at bootstrap). A committed rendered file
# drifts from its template (see PR #848), so it is not tracked. Caddyfile.tpl
# is NOT ignored.
Caddyfile
