# =============================================================================
# Kagura Memory Cloud - Environment Variables
# =============================================================================
#
# Copy this file to .env.local and fill in your credentials:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to Git (it's in .gitignore)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Local development (docker-compose)
DATABASE_URL=postgresql://kagura:kagura_dev_password@localhost:5432/kagura
DB_PASSWORD=kagura_dev_password


# -----------------------------------------------------------------------------
# Qdrant (Vector DB)
# -----------------------------------------------------------------------------

# Local development (docker-compose)
QDRANT_URL=http://localhost:6333

# -----------------------------------------------------------------------------
# Vector Backend — server (Qdrant, default) vs embedded "Kagura Lite" (preview)
# -----------------------------------------------------------------------------
# Default is "qdrant" (uses QDRANT_URL above). For a single-process,
# self-hosted / CLI / edge deployment that does not want a separate Qdrant
# server, switch to the in-process LanceDB backend (PREVIEW). Requires the
# backend "lite" optional extra:  pip install '.[lite]'
#
# Do NOT use lance for multi-worker / SaaS deployments: LanceDB is single-writer
# and the nightly Sleep maintenance writer would conflict. See
# docs/deployment.md#embedded-vector-backend-kagura-lite-preview
#
# KAGURA_VECTOR_BACKEND=lance
# KAGURA_LANCE_DB_PATH=./data/kagura.lance


# -----------------------------------------------------------------------------
# Redis (Cache)
# -----------------------------------------------------------------------------

# Local development (docker-compose)
REDIS_URL=redis://localhost:6379

# Connection pool for the singleton client (Issue #1556). Rate-limit and daily
# quota counters wait up to REDIS_POOL_TIMEOUT_SECONDS for a free connection
# instead of failing (and failing open) the moment the pool is exhausted.
# Sized per API worker process.
# REDIS_MAX_CONNECTIONS=50
# REDIS_POOL_TIMEOUT_SECONDS=2.0


# -----------------------------------------------------------------------------
# OAuth2 (Google)
# -----------------------------------------------------------------------------

# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# OAuth Provider Control (default: auto — enable all configured providers)
# AUTH_PROVIDERS=auto        # Enable all providers with credentials set
# AUTH_PROVIDERS=google      # Google only
# AUTH_PROVIDERS=github      # GitHub only
# AUTH_PROVIDERS=google,github  # Both explicitly

# Registration Control (default: false — invitation-only)
# First user is always allowed to register as admin
# ALLOW_REGISTRATION=false

# GitHub OAuth2 (optional - for GitHub login)
# Get from: https://github.com/settings/developers → OAuth Apps → New OAuth App
# GITHUB_CLIENT_ID=Ov23li...
# GITHUB_CLIENT_SECRET=...
# GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback

# Transactional Email Provider (Issue #478)
# Default 'logging' writes structured log lines that ops forwards manually (closed-beta scope).
# Switch to 'resend' once a verified sending domain + DPA acceptance (RESEND_DPA_ACCEPTED_AT below) are in place. Sub-processor disclosure is published in the Privacy Policy.
EMAIL_PROVIDER=logging                       # logging | resend
# RESEND_API_KEY=re_...                      # https://resend.com/api-keys (scope to a single sending domain)
# RESEND_FROM_EMAIL=noreply@kagura-ai.com    # must match a Resend-verified domain
# RESEND_DPA_ACCEPTED_AT=2026-01-01T00:00:00Z  # ISO 8601 UTC; required when EMAIL_PROVIDER=resend (record DPA acceptance per https://resend.com/legal/dpa)

# -----------------------------------------------------------------------------
# Security (Required)
# -----------------------------------------------------------------------------

# API Key encryption secret (auto-generated by create_admin if not set)
API_KEY_SECRET=change-me-api-key-secret

# API keys expire by default (Issue #1537). A key minted without expires_days
# lives this many days; agent-bound keys use the shorter value. Operators may
# tighten these (1-3650) but cannot make "never expires" the default — a client
# has to ask for that explicitly with expires_days=0.
# API_KEY_DEFAULT_EXPIRES_DAYS=365
# API_KEY_AGENT_DEFAULT_EXPIRES_DAYS=90

# JWT secret for session tokens (use: openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Per-deployment salt for audit_logs pseudonymization on account erasure.
# Override in production (use: openssl rand -hex 16). Rotating this value
# breaks cross-correlation between rows pseudonymized before vs after.
AUDIT_PSEUDO_SALT=kagura-erasure-v1

# HMAC-SHA256 key for keyed hashing of email values in audit_logs old/new
# value columns (Issue #481, OAuth email-sync events). Distinct from
# API_KEY_SECRET so each can rotate independently. Use: openssl rand -hex 32.
# Rotating this key breaks comparability of email hashes across the rotation
# boundary (acceptable trade-off for forward security).
AUDIT_HMAC_KEY=change-me-audit-hmac-key

# -----------------------------------------------------------------------------
# ai-worker connectors (Spec 2026-06-02)
# -----------------------------------------------------------------------------

# Shared bearer token the ai-worker presents to GET /api/v1/workers/config.
# Empty disables the endpoint (fail-closed). Rotating it requires a process
# restart (settings are cached at startup). Use: openssl rand -hex 32.
# WORKER_SERVICE_TOKEN=

# Issue #1482: blue-green identity of THIS API instance, reported as
# `responding_color` by GET /api/v1/workers/active-color. The production compose
# files set it per service (api-blue → blue, api-green → green); leave it empty
# for a single-instance / local deploy and the field is null. Any value other
# than blue|green refuses to start.
# DEPLOY_COLOR=
# Where the active-color deploy marker is mounted inside the API container. It is
# read on every request; a missing/unreadable/unknown marker answers 503
# DEPLOY-001 rather than a guessed color.
# ACTIVE_COLOR_MARKER_PATH=/run/kagura/active-color

# Issue #954: shared bearer token the billing service (kagura-billing) presents
# to PUT /internal/workspaces/{id}/plan (entitlement push). Empty disables the
# internal billing endpoints (fail-closed). Distinct from WORKER_SERVICE_TOKEN
# so the two services rotate independently. Use: openssl rand -hex 32.
# BILLING_SERVICE_TOKEN=

# Issue #1118: optional public base URL (origin, no path) of the external billing
# service's handoff entry. When set, POST /api/v1/billing/handoff ALSO returns a
# ready-to-use {base}/enter?t={token} redirect URL; empty (default) returns only
# the raw token. Opt-in convenience, inert when unset.
# PAYMENT_PUBLIC_BASE_URL=https://billing.example.com

# Public MCP base URL handed back to the worker so it can write memories.
# KMC_MCP_URL=http://localhost:8080/mcp

# Slack connector OAuth (shared Kagura Slack app). Empty SLACK_CLIENT_ID
# disables the Slack connect flow. Get from https://api.slack.com/apps.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:8080/api/v1/connectors/slack/callback
# SLACK_OAUTH_SCOPES=channels:history,channels:read,groups:history,chat:write,team:read,users:read

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
LOG_COLORIZE=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Production (replace with your domain)
# CORS_ORIGINS=https://your-domain.com

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Production (replace with your domain)
# FRONTEND_URL=https://your-domain.com

# Note: OpenAI/Cohere API keys are managed via Web UI (Workspace > Integrations > External Keys).
# They are encrypted and stored in the database — no env vars needed.

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

# development | staging | production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Neural Memory
ENABLE_NEURAL_MEMORY=true

# Research Tools
ENABLE_RESEARCH_TOOLS=true

# Owner Settings > Plan page + sidebar entry (#1145). OSS default is off —
# self-hosted deployments have no billing to hand off to. Managed/SaaS
# deployments must set this to true or the Plan page silently disappears.
# ENABLE_PLAN_PAGE=false

# BYOK (bring-your-own-key) surface (#1167). Default is on — OSS/self-hosted
# keeps external API key management. Set false to hide + block the
# external-keys console, the workspace cost dashboard, and the OpenAI
# key-status probe (their APIs return 404). Keys stored BEFORE turning
# this off are still resolved by the
# LLM/embedding services; only key CRUD and the cost dashboard are blocked.
# ENABLE_BYOK=true

# Deterministic always-load cap (Issue #886). Max memories returned by the
# load_pinned read path (delivery_mode='always'). Bounded server-side; when a
# context has more pinned memories than this, the response flags truncated=true
# with the true total_available. Commented = default 100.
# PINNED_LOAD_CAP=100

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------

EMBEDDING_PROVIDER=openai                    # openai | ollama
EMBEDDING_MODEL=text-embedding-3-small      # Model name (see EMBEDDING_MODEL_REGISTRY in constants.py)
EMBEDDING_DIMENSIONS=512                     # Vector dimensions (auto-detected from model registry)
# Issue #1030: when true, plans WITHOUT managed_embeddings (Free/S) are denied the
# platform OPENAI_API_KEY embedding fallback (must use BYOK or self-hosted Ollama);
# paid tiers (basic/pro) keep platform embeddings, bounded by the #709/#1033 cap.
# Default false = pre-#1030 behavior (env fallback for all tiers). Enable only once a
# dedicated platform embedding credential is provisioned for managed-SaaS.
# EMBEDDING_PLATFORM_FALLBACK_REQUIRES_MANAGED_PLAN=false

# Ollama Configuration (only needed if EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434       # Ollama API base URL

# Self-hosted / OpenAI-compatible embedding backend (models whose registry
# provider is self_hosted, e.g. qwen3-embedding:4b). Issue #1525: if the backend
# serves a model under a different id than the registry name (a HF path on vLLM,
# a vendor prefix on a hosted endpoint), alias it here. Only the wire `model`
# changes — collection name, cache key and allowlist keep the registry name.
# SELF_HOSTED_BASE_URL=http://localhost:11434
# SELF_HOSTED_API_KEY=
# SELF_HOSTED_MODEL_ALIASES=qwen3-embedding:4b=Qwen/Qwen3-Embedding-4B
# Issue #1570: price a paid self-hosted (or any) model so cost tracking and the
# embedding spend cap see it. JSON array; `model` is the registry name, prices are
# USD per `unit_denominator` units (default 1,000,000). Appended to `llm_pricing`
# at startup (or `python -m src.cli.sync_llm_pricing --apply`); a malformed value
# refuses to boot. Unpriced self-hosted models stay uncapped and report cost as
# unknown. See docs/deployment.md "LLM & Embedding Pricing".
# LLM_PRICING_OVERRIDES='[{"provider":"self_hosted","model":"qwen3-embedding:4b","unit_type":"embedding_tokens","price_per_unit":0.02}]'

# OpenAI API KEY
OPENAI_API_KEY=                             #  OpenAI API Key to use for embeddings (set via Web UI in Integrations > External Keys)

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
# Reranking (#1572; docs/deployment.md "Reranking"). ENABLE_RERANKING is the
# deployment kill switch (default true): false = no context ever reranks.
# ENABLE_RERANKING=true

# Deployment default stamped on NEW context search configs. Existing rows are not
# rewritten — run `python -m src.cli.apply_rerank_defaults --all --apply` for those.
# Unset = off / voyage / rerank-2 (previous behaviour). self_hosted is keyless;
# voyage/cohere still need a BYOK key per workspace. DEFAULT_USE_RERANK=true with
# self_hosted requires RERANK_BASE_URL or SELF_HOSTED_BASE_URL (refuses to boot).
# DEFAULT_RERANKER_PROVIDER=voyage             # voyage | cohere | self_hosted
# DEFAULT_USE_RERANK=false
# DEFAULT_RERANKER_MODEL=                      # empty = provider default (self_hosted: RERANK_MODEL)

# Self-hosted reranker backends (provider self_hosted). RERANK_BASE_URL = one
# batched OpenAI/Jina-style POST /v1/rerank (vLLM --runner pooling, TEI, Infinity);
# unset it and self_hosted falls back to per-document prompt scoring on
# SELF_HOSTED_BASE_URL with SELF_HOSTED_RERANK_MODEL (an Ollama-registry id by
# default — a pure-vLLM stack must set a model it actually serves).
# RERANK_BASE_URL=http://localhost:8002
# RERANK_MODEL=qwen3-reranker-0.6b             # served model name on RERANK_BASE_URL
# RERANK_API_KEY=                              # bearer token if that endpoint is behind auth
# SELF_HOSTED_RERANK_MODEL=dengcao/Qwen3-Reranker-8B:Q5_K_M

# -----------------------------------------------------------------------------
# Usage Warning Thresholds (Issue #48)
# -----------------------------------------------------------------------------

# Usage Warning Thresholds (0.0-1.0)
USAGE_WARNING_THRESHOLD=0.80    # 80% - Show warning
USAGE_CRITICAL_THRESHOLD=0.95   # 95% - Show critical alert

# -----------------------------------------------------------------------------
# Neural Memory Configuration
# -----------------------------------------------------------------------------
# Tunable parameters (27 total) are managed in the database via Admin UI
# at /admin/neural-config. Only feature flags are configured here.

TRACK_CO_ACTIVATION=true        # Enable co-activation tracking
ENABLE_DECAY=true               # Enable automatic edge weight decay
ENABLE_TRUST_MODULATION=true    # Modulate learning by confidence score

# -----------------------------------------------------------------------------
# Plan Tier Overrides (optional, for OSS deployments)
# -----------------------------------------------------------------------------

# Override default plan limits via environment variables.
# Uncomment and set values to customize.
# PLAN_FREE_MAX_CONTEXTS=3
# PLAN_FREE_MEMORY_LIMIT=1000
# PLAN_FREE_MEMORIES_PER_DAY=50          # memories created per UTC day (0 = none, not unlimited)
# PLAN_FREE_MCP_CALLS_PER_DAY=1000
# PLAN_BASIC_MAX_CONTEXTS=10
# PLAN_BASIC_MEMORY_LIMIT=10000
# PLAN_BASIC_MEMORIES_PER_DAY=300
# PLAN_BASIC_MCP_CALLS_PER_DAY=10000
# PLAN_PRO_MAX_CONTEXTS=20
# PLAN_PRO_MEMORY_LIMIT=100000
# PLAN_PRO_MEMORIES_PER_DAY=2000
# PLAN_PRO_MCP_CALLS_PER_DAY=50000
# PLAN_PROMAX_MAX_CONTEXTS=1000
# PLAN_PROMAX_MEMORY_LIMIT=100000
# PLAN_PROMAX_MEMORIES_PER_DAY=10000
# PLAN_PROMAX_MCP_CALLS_PER_DAY=250000
#
# Issue #1550: owned-workspace slots each tier GRANTS its owner on top of the
# per-user base (1) and slot bonus — the highest tier the user owns applies
# (defaults FREE 0 / BASIC 0 / PRO 2 / PROMAX 19 → a user may own 1/1/3/20).
# Only creating a new workspace is gated (ENFORCE_WORKSPACE_CAP, default false).
# PLAN_FREE_OWNED_WORKSPACE_GRANT=0
# PLAN_BASIC_OWNED_WORKSPACE_GRANT=0
# PLAN_PRO_OWNED_WORKSPACE_GRANT=2
# PLAN_PROMAX_OWNED_WORKSPACE_GRANT=19
#
# Issue #1559: replace a tier's feature set (comma-separated; REPLACES the whole
# set). Names must be known to config/plan_tiers.py (KNOWN_FEATURES); every tier
# must keep secret_store and resources requires public_contexts — a violation
# refuses to boot. Lets a self-host re-enable the XL-only resources /
# connectors / public_contexts on a lower tier. Defaults shown.
# PLAN_FREE_FEATURES=api_keys,oauth,secret_store
# PLAN_BASIC_FEATURES=api_keys,oauth,reranking,managed_embeddings,secret_store
# PLAN_PRO_FEATURES=api_keys,oauth,reranking,managed_embeddings,secret_store,team_invitations,shared_contexts,memory_analysis
# PLAN_PROMAX_FEATURES=api_keys,oauth,reranking,managed_embeddings,secret_store,team_invitations,shared_contexts,memory_analysis,resources,connectors,public_contexts

# -----------------------------------------------------------------------------
# BM25 IDF Drift Observability (Issue #343)
# -----------------------------------------------------------------------------
# Tracks BM25 IDF distribution drift in the kagura_memories collection.
# DISABLED BY DEFAULT in v0.12.1; production enablement is scheduled for
# v0.14.0 (after #359 Privacy Policy and #360 right-to-erasure land).
# Mirrors the sleep_enabled gating pattern (env-only feature flag).
#
# BM25_DRIFT_CRON_ENABLED=false   # set to "true" to register the daily cron
# BM25_DRIFT_CRON_HOUR=3          # UTC hour, default 3 (offset from sleep at 2)
# BM25_DRIFT_CRON_MINUTE=0

# -----------------------------------------------------------------------------
# Object Storage / Cloudflare R2 (Issue #485 Phase 1)
# -----------------------------------------------------------------------------
# Platform-managed file storage for SDK File Ingestion BLOBs. Empty values
# disable the file-storage feature entirely — the /api/v1/files routes and
# MCP file tools return a clear error on first call until storage is configured.
#
# Any S3-compatible backend works (Issue #994): Cloudflare R2 (managed cloud),
# MinIO or AWS S3 (self-host). The same client drives all of them — only the
# endpoint differs. STORAGE_* are the canonical names; the legacy R2_* names
# below are still accepted as aliases (existing deploys keep working unchanged).
# See docs/deployment.md for the self-host (MinIO) walkthrough.
#
# STORAGE_BACKEND_TYPE=r2          # r2 | s3 | minio | s3-compatible | aws
# STORAGE_REGION=auto              # 'auto' for R2/MinIO; real region (e.g. us-east-1) for aws
# STORAGE_ACCOUNT_ID=              # R2 account ID; any non-empty value for MinIO/AWS
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=kagura-memory-files-dev
# STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com  # MinIO: http://minio:9000
#
# Legacy aliases (deprecated; still honored — a one-time deprecation line is
# logged when only R2_* is set and no STORAGE_*):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kagura-memory-files-dev
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#
# Issue #556 sha256 binding gate. When True, R2 verifies the body's sha256
# server-side via S3 ChecksumSHA256 and rejects mismatched bytes with HTTP
# 400 BadDigest. REQUIRES kagura-memory-python-sdk >= 0.14.0 (FilesClient
# shipped 2026-05-11; older v0.13.x clients lack the x-amz-checksum-sha256
# header and fail with HTTP 403). Default False keeps Phase 1 behavior so
# backend can deploy ahead of SDK rollout. See CHANGELOG entry for #556 for
# the staged rollout sequence and docs/ops/r2-checksum-binding-rollout.md §10
# for default-flip / flag-removal criteria (#577).
# STORAGE_CHECKSUM_BINDING_ENABLED=false   # alias: R2_CHECKSUM_BINDING_ENABLED
#
# Per-file Phase 1 cap (MiB). Hard ceiling enforced server-side; clients
# uploading more than this fail at upload-init.
# FILE_OBJECT_MAX_SIZE_MB=100
#
# Presigned URL TTLs (seconds). PUT covers the time between upload-init
# and the client's PUT completing; GET is the lifetime of a download
# link. Both default to 5 minutes.
# PRESIGN_PUT_TTL_SECONDS=300
# PRESIGN_GET_TTL_SECONDS=300
#
# MIME allow-list for file uploads (Issue #553). Comma-separated.
# Comparison is case-insensitive (RFC 6838). Empty = deny all (fail-closed).
# Default mirrors the closed-beta set.
# ALLOWED_FILE_CONTENT_TYPES=image/png,image/jpeg,image/gif,application/pdf,text/plain,text/markdown,text/csv,application/json
#
# Per-tier storage caps (bytes; commented = uses defaults — see
# config/plan_tiers.py: FREE 100 MiB / BASIC 1 GiB / PRO 10 GiB / PROMAX 50 GiB).
# PLAN_FREE_STORAGE_LIMIT_BYTES=104857600    # 100 MiB
# PLAN_BASIC_STORAGE_LIMIT_BYTES=1073741824  # 1 GiB
# PLAN_PRO_STORAGE_LIMIT_BYTES=10737418240   # 10 GiB
# PLAN_PROMAX_STORAGE_LIMIT_BYTES=53687091200  # 50 GiB

# Issue #560: Per-tier sleep-enabled contexts cap (commented = uses defaults
# — see config/plan_tiers.py: FREE 0 / BASIC 0 / PRO 3 / PROMAX 15). Sleep
# Maintenance is a PRO+ LLM-bearing feature; the cap can be increased
# per-workspace via the extra_sleep_contexts addon.
# PLAN_FREE_SLEEP_ENABLED_CONTEXTS_LIMIT=0
# PLAN_BASIC_SLEEP_ENABLED_CONTEXTS_LIMIT=0
# PLAN_PRO_SLEEP_ENABLED_CONTEXTS_LIMIT=3
# PLAN_PROMAX_SLEEP_ENABLED_CONTEXTS_LIMIT=15

# Issue #1521: platform-wide tombstone sweep — hard-deletes every soft-deleted
# memory (forget, merge loser, consolidation archive) older than this many
# days, whether or not Sleep runs. 0 disables the sweep. Bounds undo/rollback.
# CLEANUP_DELETED_MEMORIES_RETENTION_DAYS=30

# Issue #1049: Sleep consolidation now gates promotion/archival on the adoption
# signal (reference_count, #1046) instead of surfacing (access_count). The
# adoption==0 ARCHIVAL path only deletes memories created at/after this cutoff —
# unset (default) disables adoption-based deletion entirely (no pre-migration
# memory is ever archived; RELEASE BLOCKER guarantee). Set it to the #1046/#1049
# deploy date (naive-UTC ISO) once enough post-deploy adoption data has accrued.
# CONSOLIDATION_ADOPTION_DELETE_CUTOFF=2026-06-19T00:00:00

# Issue #675 (epic #674): per-user owned-workspace cap = 1 (base) +
# users.workspace_slot_bonus. The plan tier no longer drives this cap;
# joining workspaces via invitation remains uncapped (the inviting
# workspace's owner pays for the seat). Phase 1 sets bonus manually
# (admin UI in #676); phase 2 wires Stripe slot purchases.

# Issue #661 / #675 rollout gate. When false (default), workspace creation
# is allowed unconditionally but a structured warn log is emitted whenever
# a user is over their effective cap (1 + workspace_slot_bonus) — used to
# surface affected accounts before enforcement. Flip to true after the
# TOCTOU mitigation lands (tracked in #677, sub-C).
# ENFORCE_WORKSPACE_CAP=false

# -----------------------------------------------------------------------------
# Production Deployment
# -----------------------------------------------------------------------------

# Update these for your production domain:
# CORS_ORIGINS=https://your-domain.com
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/auth/google/callback
# LOG_LEVEL=info
# ENVIRONMENT=production
