# =============================================================================
# Kagura Memory Cloud — production .env
# =============================================================================
# Copy to .env.prod on the VM and fill in real values.
# NEVER commit the filled .env.prod — it contains secrets.
#
#   cp .env.prod.example .env.prod
#   vim .env.prod
#
# docker-compose.prod.yml reads this via env_file.
# =============================================================================

# -----------------------------------------------------------------------------
# Your domain (used by docker-compose.prod.yml to pass NEXT_PUBLIC_API_URL)
# -----------------------------------------------------------------------------
KAGURA_DOMAIN=memory.example.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Strong password — generate with: openssl rand -base64 32
DB_PASSWORD=change-me-db-password

# -----------------------------------------------------------------------------
# API workers and Postgres connections (#1980) — optional
# -----------------------------------------------------------------------------
# Unset, each API container runs one uvicorn process and Postgres keeps its
# default max_connections (100) — the same as before these knobs existed.
#
# Every worker opens its own DB pools (async + OAuth sync engine), so the
# Postgres connection ceiling must cover, per color:
#   UVICORN_WORKERS x 2 x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# x 2 while both colors run during a blue/green switch, plus Sleep / CLI runs,
# co-resident workers and operator psql sessions — keep the total below
# POSTGRES_MAX_CONNECTIONS. Raise POSTGRES_MAX_CONNECTIONS first (recreating
# Postgres applies it), then UVICORN_WORKERS. Pick workers from CPU cores
# (4 cores -> 2-4) after checking that CPU, not the pool, is the bottleneck.
# Split host: the data host's docker-compose.data.yml is updated by hand.
# See docs/deployment.md "Multiple API workers and Postgres connections".
# UVICORN_WORKERS=2
# POSTGRES_MAX_CONNECTIONS=200
# Only one process runs the background scheduler (Postgres leader lock, held
# on a slot of that worker's own pool — no extra connection); a standby
# retries this often (seconds, min 5) and takes over when it exits.
# SCHEDULER_LEADER_RETRY_SECONDS=60
# The leader checks its lock connection this often (seconds, min 1); after a
# Postgres restart it keeps dispatching for at most this + 15 s while a
# standby may already hold the lock.
# SCHEDULER_LEADER_PING_SECONDS=10

# -----------------------------------------------------------------------------
# Container log rotation (#2025) — optional
# -----------------------------------------------------------------------------
# Unset: every container keeps json-file logs capped at 50m x 3, as before.
# API_LOG_* caps api-blue / api-green; LOG_* caps every other service (web,
# caddy, the data tier). Applied only when a container is recreated: deploy.sh
# recreates the incoming API color only, caddy / web need their own
# `up -d --no-deps --force-recreate`. A stopped standby color keeps its log
# files, so the API can take 2 x API_LOG_MAX_SIZE x API_LOG_MAX_FILE of disk.
# daemon.json log-opts do not override these. See docs/deployment.md
# "Container log rotation".
# API_LOG_MAX_SIZE=50m
# API_LOG_MAX_FILE=3
# LOG_MAX_SIZE=50m
# LOG_MAX_FILE=3

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
# REQUIRED in production (dev leaves this empty).
# Generate with: openssl rand -hex 32
QDRANT_API_KEY=change-me-qdrant-api-key

# -----------------------------------------------------------------------------
# Redis — optional password (#1794)
# -----------------------------------------------------------------------------
# Unset: Redis runs without auth on the private compose network, as before.
# Set: Redis requires it, and the API's Redis URL is built from it — on a
# single host this one line is all. Turning it on restarts Redis; see
# docs/deployment.md "Redis Password".
# Generate with: openssl rand -hex 32 (hex needs no quoting or URL-encoding)
# REDIS_PASSWORD=change-me-redis-password
# Only for a password with characters a URL reserves (percent-encode them), or
# a Redis elsewhere: the whole URL, which then replaces the built one.
# REDIS_URL='redis://:<password, URL-encoded>@redis:6379'

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------
# API Key encryption secret. Generate with: openssl rand -hex 32
API_KEY_SECRET=change-me-api-key-secret

# JWT secret for session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Per-deployment salt for audit_logs pseudonymization on account erasure
# (Issue #407). Generate with: openssl rand -hex 16. Rotating this value
# breaks cross-correlation between rows pseudonymized before vs after the
# rotation boundary.
AUDIT_PSEUDO_SALT=change-me-audit-pseudo-salt

# HMAC-SHA256 key for keyed hashing of email values in audit_logs old/new
# value columns (Issue #481, OAuth email-sync events). Distinct from
# API_KEY_SECRET so each can rotate independently. Generate with:
# openssl rand -hex 32. Rotating breaks comparability of email hashes
# across the rotation boundary (acceptable trade-off for forward security).
AUDIT_HMAC_KEY=change-me-audit-hmac-key

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
LOG_COLORIZE=false

ENVIRONMENT=production

# CORS — only your own domain (Caddy is the only public surface)
CORS_ORIGINS=https://memory.example.com

# Frontend URL (used for OAuth redirects etc.)
FRONTEND_URL=https://memory.example.com

# -----------------------------------------------------------------------------
# OAuth2 — Google (required for first admin sign-in via OAuth)
# -----------------------------------------------------------------------------
# Get from https://console.cloud.google.com/apis/credentials
# Add https://memory.example.com/api/v1/auth/google/callback as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://memory.example.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# OAuth2 — GitHub (optional)
# -----------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://memory.example.com/api/v1/auth/github/callback

# Provider control. "auto" enables everything that has credentials set.
AUTH_PROVIDERS=auto

# Registration. Keep false in production; invite users via admin UI.
ALLOW_REGISTRATION=false

# Terms-of-service acceptance (Issue #1665). Empty = disabled. Set it to the
# current terms version to record acceptance and ask users when it changes.
# TERMS_VERSION=

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Default: OpenAI managed embeddings. For Ollama local embeddings, use the
# docker-compose.ollama.yml override instead (it overrides EMBEDDING_PROVIDER
# and OLLAMA_BASE_URL).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# #1517: which registry models this deployment offers to callers, comma-
# separated. Empty (the default) offers all of them, i.e. unchanged behaviour.
# Set it when the deployment cannot actually serve every model — e.g. a
# self-hosted embedding endpoint, where the OpenAI entries only resolve for a
# workspace that supplies its own BYOK key. Contexts pin their model
# permanently (#146), so a context created against a model this deployment
# cannot serve is not repairable in place.
# EMBEDDING_MODEL_ALLOWLIST=qwen3-embedding:4b

# -----------------------------------------------------------------------------
# OpenAI API Key (optional here — can also be set per-workspace in the UI)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_NEURAL_MEMORY=true
ENABLE_RESEARCH_TOOLS=false
ENABLE_RERANKING=false
# Owner Settings > Plan page + sidebar entry (#1145). Backend default is
# false (OSS/self-hosted has no billing) — managed/SaaS prod MUST set true
# or the Plan page silently disappears for owners.
ENABLE_PLAN_PAGE=true
# BYOK provisioning (#1167). Default true (BYOK available). Set false to close
# key provisioning (create / update 404) and hide the workspace cost dashboard
# and key-status probe (both 404).
# Already-stored keys are still resolved and stay listable / toggleable /
# deletable by the owner; their nav entry stays while such keys exist (#1616).
ENABLE_BYOK=true
# Cost display (#1571). Default true. Set false on a flat-price deployment to
# hide money from workspace users (workspace cost dashboard 404 + hidden, no
# analysis cost KPI / column / estimate, cost fields dropped from analysis
# REST/MCP payloads). /admin/cost stays available to system admins.
ENABLE_COST_DISPLAY=true
# Managed-connectors mode (#1426). Default false (OSS/self-host: shows the BYO
# "link existing Slack app" form and requires a per-connector LLM). Managed/SaaS
# prod sets true so the connectors UI hides the BYO form and stops requiring a
# per-connector LLM (the shared worker/bridge provides the pre-compile LLM).
ENABLE_MANAGED_CONNECTORS=true

# Neural memory sub-features
TRACK_CO_ACTIVATION=true
ENABLE_DECAY=true
ENABLE_TRUST_MODULATION=true

# Sleep Maintenance
SLEEP_ENABLED=true
SLEEP_CRON_HOUR=2
SLEEP_CRON_MINUTE=0
# Tombstone sweep window in days for every soft-deleted memory (#1521); 0 disables.
CLEANUP_DELETED_MEMORIES_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Usage Warning Thresholds
# -----------------------------------------------------------------------------
USAGE_WARNING_THRESHOLD=0.80
USAGE_CRITICAL_THRESHOLD=0.95

# Owned-workspace cap enforcement (#674 epic / #677 sub-C):
#   cap = 1 + users.workspace_slot_bonus
#         (bonus is admin-grantable via
#          PATCH /api/v1/admin/users/{user_id}/workspace_slot_bonus)
#   false (default in backend) → warn-only, never denies workspace creation
#   true                        → deny over-cap creation with QuotaExceededError 4xx
# Recommended after the rollout runbook is validated. Flip to "false" only
# if false-positive denials appear — see docs/ops/workspace-cap-rollback.md
# for the recovery procedure.
ENFORCE_WORKSPACE_CAP=true

# -----------------------------------------------------------------------------
# Split-host layout (app VM + data VM) — leave unset on a single host
# -----------------------------------------------------------------------------
# Where the app tier reaches the databases. Unset (the single-host default)
# means the compose service names, i.e. the stack behaves exactly as before.
# On a split-host app VM, set all three to the data VM's private address.
# See README "Optional: split-host layout".
# POSTGRES_HOST=192.168.10.20
# QDRANT_HOST=192.168.10.20
# REDIS_HOST=192.168.10.20

# DATA VM only, with docker-compose.data-expose.yml: the private address the
# database ports are published on. Deliberately has no default — an unset value
# would bind 0.0.0.0 and expose PostgreSQL, Qdrant and Redis on every interface.
# DATA_BIND_ADDR=192.168.10.20
