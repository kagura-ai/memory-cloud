# =============================================================================
# Kagura Memory Cloud — production .env
# =============================================================================
# Copy to .env.prod on the VM and fill in real values.
# NEVER commit the filled .env.prod — it contains secrets.
#
#   cp .env.prod.example .env.prod
#   vim .env.prod
#
# docker-compose.prod.yml reads this via env_file.
# =============================================================================

# -----------------------------------------------------------------------------
# Your domain (used by docker-compose.prod.yml to pass NEXT_PUBLIC_API_URL)
# -----------------------------------------------------------------------------
KAGURA_DOMAIN=memory.example.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Strong password — generate with: openssl rand -base64 32
DB_PASSWORD=change-me-db-password

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
# REQUIRED in production (dev leaves this empty).
# Generate with: openssl rand -hex 32
QDRANT_API_KEY=change-me-qdrant-api-key

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------
# API Key encryption secret. Generate with: openssl rand -hex 32
API_KEY_SECRET=change-me-api-key-secret

# JWT secret for session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
LOG_COLORIZE=false

ENVIRONMENT=production

# CORS — only your own domain (Caddy is the only public surface)
CORS_ORIGINS=https://memory.example.com

# Frontend URL (used for OAuth redirects etc.)
FRONTEND_URL=https://memory.example.com

# -----------------------------------------------------------------------------
# OAuth2 — Google (required for first admin sign-in via OAuth)
# -----------------------------------------------------------------------------
# Get from https://console.cloud.google.com/apis/credentials
# Add https://memory.example.com/api/v1/auth/google/callback as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://memory.example.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# OAuth2 — GitHub (optional)
# -----------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://memory.example.com/api/v1/auth/github/callback

# Provider control. "auto" enables everything that has credentials set.
AUTH_PROVIDERS=auto

# Registration. Keep false in production; invite users via admin UI.
ALLOW_REGISTRATION=false

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Default: OpenAI managed embeddings. For Ollama local embeddings, use the
# docker-compose.ollama.yml override instead (it overrides EMBEDDING_PROVIDER
# and OLLAMA_BASE_URL).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# -----------------------------------------------------------------------------
# OpenAI API Key (optional here — can also be set per-workspace in the UI)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_NEURAL_MEMORY=true
ENABLE_RESEARCH_TOOLS=false
ENABLE_RERANKING=false

# Neural memory sub-features
TRACK_CO_ACTIVATION=true
ENABLE_DECAY=true
ENABLE_TRUST_MODULATION=true

# Sleep Maintenance
SLEEP_ENABLED=true
SLEEP_CRON_HOUR=2
SLEEP_CRON_MINUTE=0

# -----------------------------------------------------------------------------
# Usage / Plan Limits
# -----------------------------------------------------------------------------
DEFAULT_PLAN_MEMORY_LIMIT=1000
DEFAULT_PLAN_DAILY_API_LIMIT=1000
DEFAULT_PLAN_WEEKLY_API_LIMIT=5000
USAGE_WARNING_THRESHOLD=0.80
USAGE_CRITICAL_THRESHOLD=0.95

# -----------------------------------------------------------------------------
# Billing (disabled by default)
# -----------------------------------------------------------------------------
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
